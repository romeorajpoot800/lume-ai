HF_API_KEY=REPLACE_WITH_YOUR_HUGGINGFACE_API_KEY

# Usage examples:
# flutter run --dart-define=HF_API_KEY=your_key_here
# flutter build apk --release --dart-define=HF_API_KEY=your_key_here

# Notes:
# - Do NOT commit a real .env file. Keep sensitive keys out of source control.
# - For CI, set an environment variable and pass it to `flutter build` using --dart-define.
